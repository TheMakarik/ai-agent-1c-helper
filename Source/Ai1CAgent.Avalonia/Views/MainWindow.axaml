<Window
    x:Class="Ai1CAgent.Avalonia.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Ai1CAgent.Avalonia.Views.Converters"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:models="using:Ai1CAgent.Core.Models"
    xmlns:controls="using:Ai1CAgent.Avalonia.Views.Controls"
    xmlns:vm="using:Ai1CAgent.Avalonia.ViewModels"
    xmlns:views="using:Ai1CAgent.Avalonia.Views"
    Width="1040"
    Height="720"
    MinWidth="820"
    MinHeight="480"
    Background="{StaticResource ContentBrush}"
    Foreground="{StaticResource TextBrush}"
    Icon="/Assets/avalonia-logo.ico"
    Title="{Binding Title}">

    <Window.Styles>

        <!--  Папка выгрузки конфигурации в шапке чата  -->
        <Style Selector="Border.configuration-bar">
            <Setter Property="Background" Value="{StaticResource BubbleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <Style Selector="TextBlock.configuration-path">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style Selector="TextBlock.configuration-hint">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style Selector="TextBlock.configuration-warning">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>

        <!--  Кнопка выбора ИИ в чате  -->
        <Style Selector="ToggleButton.model-picker">
            <Setter Property="Background" Value="{StaticResource BubbleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="ToggleButton.model-picker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BubbleBrush}" />
        </Style>

        <Style Selector="ToggleButton.model-picker:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
        </Style>

        <Style Selector="TextBlock.model-picker-provider">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.model-picker-model">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Меню выбора: провайдеры слева, модели справа  -->
        <Style Selector="Border.model-picker-menu">
            <Setter Property="Background" Value="{StaticResource BubbleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="ListBox.model-picker-providers">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.model-picker-providers ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style Selector="ListBox.model-picker-providers ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
        </Style>

        <Style Selector="ListBox.model-picker-providers ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.model-picker-providers ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
        </Style>

        <Style Selector="Button.model-picker-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="Button.model-picker-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
        </Style>

        <Style Selector="Button.model-picker-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
        </Style>

        <Style Selector="TextBlock.model-picker-empty">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="TextBlock.status-context">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SidebarHeaderBrush}" />
        </Style>

        <!--  Папка проекта внизу сайдбара  -->
        <Style Selector="Button.project-folder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.project-folder:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
        </Style>

        <Style Selector="Button.project-folder:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!--  Выполняемый инструмент агента в сообщении  -->
        <Style Selector="TextBlock.tool-activity">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="206,*">

        <!--  Боковая панель: логотип и история диалогов  -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}">
            <Grid
                Margin="12,8,12,12"
                RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                RowSpacing="8">
                <StackPanel
                    Grid.Row="0"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image Height="30" Source="{StaticResource LogoImage}" />
                    <Image
                        Height="36"
                        Source="avares://Ai1CAgent.Avalonia/Assets/apogey-logo.png" />
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Classes="sidebar-header"
                    Text="История диалогов" />
                <Button
                    Grid.Row="2"
                    Classes="sidebar-button"
                    Command="{Binding NewDialogCommand}"
                    ToolTip.Tip="Начать новый диалог">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <ic:FluentIcon
                            Icon="ChatAdd"
                            IconSize="Size20"
                            IconVariant="Regular" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Новый диалог" />
                    </StackPanel>
                </Button>
                <ListBox
                    Grid.Row="3"
                    Classes="dialogs"
                    ItemsSource="{Binding Dialogs}"
                    SelectedItem="{Binding SelectedDialog}"
                    ToolTip.Tip="История диалогов">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatDialogViewModel">
                            <Panel>
                                <TextBlock
                                    IsVisible="{Binding !IsRenaming}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBox
                                    IsVisible="{Binding IsRenaming}"
                                    KeyDown="OnDialogRenameKeyDown"
                                    LostFocus="OnDialogRenameLostFocus"
                                    Text="{Binding PendingTitle, Mode=TwoWay}" />
                                <Panel.ContextMenu>
                                    <ContextMenu Classes="chat-menu">
                                        <MenuItem Click="OnRenameDialogClick" Header="Переименовать">
                                            <MenuItem.Icon>
                                                <ic:FluentIcon
                                                    Icon="Edit"
                                                    IconSize="Size16"
                                                    IconVariant="Regular" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Click="OnDeleteDialogClick" Header="Удалить">
                                            <MenuItem.Icon>
                                                <ic:FluentIcon
                                                    Icon="Delete"
                                                    IconSize="Size16"
                                                    IconVariant="Regular" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Panel.ContextMenu>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel
                    Grid.Row="4"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding SelectedDialog.HasContextUsage}"
                    ToolTip.Tip="{Binding SelectedDialog.ContextUsageTooltip}">
                    <ic:FluentIcon
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SidebarHeaderBrush}"
                        Icon="DataUsage"
                        IconSize="Size16"
                        IconVariant="Regular" />
                    <TextBlock
                        Classes="status-context"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedDialog.ContextUsageText}" />
                </StackPanel>

                <!--  Папка активного проекта: иконка, ховер, открытие в проводнике  -->
                <Button
                    Grid.Row="5"
                    Margin="8,0,0,0"
                    Padding="0,4"
                    HorizontalAlignment="Stretch"
                    Classes="project-folder"
                    Command="{Binding OpenProjectFolderCommand}"
                    CommandParameter="{Binding Projects.SelectedProject.Path}"
                    IsVisible="{Binding Projects.HasSelection}"
                    ToolTip.Tip="Показать папку">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ic:FluentIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Icon="Folder"
                            IconSize="Size16"
                            IconVariant="Regular" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Projects.SelectedProject.Path}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,*">

            <!--  Верхнее меню разделов  -->
            <Border
                Grid.Row="0"
                Height="56"
                Background="{StaticResource TopBarBrush}">
                <Grid ColumnDefinitions="*">
                    <ListBox
                        Grid.Column="0"
                        Classes="nav"
                        ItemsSource="{Binding Sections}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedSection}"
                        ToolTip.Tip="Разделы приложения">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ic:FluentIcon
                                        Icon="{Binding Section, Converter={converters:AppSectionToIconConverter}}"
                                        IconSize="Size24"
                                        IconVariant="Regular" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Title}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  Чат  -->
            <Grid
                Grid.Row="1"
                IsVisible="{Binding IsChatSelected}"
                RowDefinitions="Auto,*,Auto">

                <!--  Папка выгрузки конфигурации 1С текущего чата  -->
                <Border
                    Grid.Row="0"
                    Margin="40,12,52,0"
                    Classes="configuration-bar">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <ic:FluentIcon
                            Grid.Column="0"
                            Foreground="{StaticResource MutedTextBrush}"
                            Icon="FolderOpen"
                            IconSize="Size20"
                            IconVariant="Regular"
                            VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center">
                            <TextBlock
                                Classes="configuration-path"
                                IsVisible="{Binding SelectedDialog.HasConfiguration}"
                                Text="{Binding SelectedDialog.ConfigurationPath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding SelectedDialog.ConfigurationPath}" />
                            <TextBlock
                                Classes="configuration-hint"
                                IsVisible="{Binding !SelectedDialog.HasConfiguration}"
                                Text="Папка выгрузки конфигурации не выбрана — агент не видит конфигурацию"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Classes="configuration-warning"
                                IsVisible="{Binding SelectedDialog.IsConfigurationWarningVisible}"
                                Text="В папке нет Configuration.xml — это не выгрузка конфигурации («Конфигурация → Выгрузить конфигурацию в файлы»)"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Classes="icon-button"
                            Command="{Binding SelectConfigurationCommand}"
                            ToolTip.Tip="Выбрать папку выгрузки конфигурации 1С для этого чата"
                            VerticalAlignment="Center">
                            <ic:FluentIcon
                                Icon="FolderSearch"
                                IconSize="Size20"
                                IconVariant="Regular" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Classes="icon-button"
                            Command="{Binding ClearConfigurationCommand}"
                            IsVisible="{Binding SelectedDialog.HasConfiguration}"
                            ToolTip.Tip="Отвязать папку от этого чата"
                            VerticalAlignment="Center">
                            <ic:FluentIcon
                                Icon="Dismiss"
                                IconSize="Size20"
                                IconVariant="Regular" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="MessagesScrollViewer"
                    Grid.Row="1">
                    <ItemsControl
                        Margin="64,24,52,24"
                        ItemsSource="{Binding SelectedDialog.Messages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="28" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                <Grid
                                    Classes="message"
                                    Classes.user="{Binding IsUser}"
                                    RowDefinitions="*,Auto">
                                    <Border
                                        Grid.Row="0"
                                        Classes="bubble">
                                        <StackPanel Spacing="10">
                                            <StackPanel IsVisible="{Binding IsReasoningVisible}" Spacing="6">
                                                <ToggleButton
                                                    Classes="thought"
                                                    HorizontalAlignment="Left"
                                                    IsChecked="{Binding IsReasoningExpanded}"
                                                    ToolTip.Tip="Размышления модели. Нажмите, чтобы раскрыть или скрыть">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <ic:FluentIcon
                                                            Icon="BrainCircuit"
                                                            IconSize="Size16"
                                                            IconVariant="Regular" />
                                                        <TextBlock
                                                            Classes="thought-title"
                                                            Text="{Binding ReasoningTitle}"
                                                            VerticalAlignment="Center" />
                                                        <ic:FluentIcon
                                                            Icon="ChevronDown"
                                                            IconSize="Size12"
                                                            IconVariant="Regular"
                                                            IsVisible="{Binding IsReasoningExpanded}" />
                                                        <ic:FluentIcon
                                                            Icon="ChevronRight"
                                                            IconSize="Size12"
                                                            IconVariant="Regular"
                                                            IsVisible="{Binding !IsReasoningExpanded}" />
                                                    </StackPanel>
                                                </ToggleButton>

                                                <Border Classes="thought-body" IsVisible="{Binding IsReasoningBodyVisible}">
                                                    <ScrollViewer
                                                        MaxHeight="320"
                                                        HorizontalScrollBarVisibility="Disabled"
                                                        VerticalScrollBarVisibility="Auto">
                                                        <SelectableTextBlock
                                                            Classes="thought-text"
                                                            Text="{Binding Reasoning}"
                                                            TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Blocks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MessageBlockViewModel">
                                                        <Panel>
                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                IsVisible="{Binding IsTool}">
                                                                <ic:FluentIcon
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{StaticResource TextBrush}"
                                                                    Icon="Wrench"
                                                                    IconSize="Size16"
                                                                    IconVariant="Regular" />
                                                                <TextBlock
                                                                    Classes="tool-activity"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding ToolName}" />
                                                            </StackPanel>
                                                            <Panel IsVisible="{Binding !IsTool}">
                                                                <SelectableTextBlock
                                                                    Text="{Binding Text}"
                                                                    TextWrapping="Wrap"
                                                                    IsVisible="{Binding IsUser}" />
                                                                <controls:MarkdownView
                                                                    Markdown="{Binding Text}"
                                                                    IsVisible="{Binding !IsUser}" />
                                                            </Panel>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock
                                                Classes="message-time"
                                                HorizontalAlignment="Right"
                                                Text="{Binding TimeText}" />
                                        </StackPanel>
                                    </Border>
                                    <Panel
                                        Grid.Row="1"
                                        Classes="tail">
                                        <Path Classes="tail-fill" />
                                        <Path Classes="tail-stroke" />
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    Margin="40,0,52,16"
                    Classes="input">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBox
                            Grid.Column="0"
                            Classes="prompt"
                            MaxLines="4"
                            MinLines="1"
                            PlaceholderText="Напишите сообщение…"
                            Text="{Binding Prompt}"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ToolTip.Tip="Введите сообщение, Enter — отправить">
                            <TextBox.KeyBindings>
                                <KeyBinding
                                    Command="{Binding SendCommand}"
                                    Gesture="Enter" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <ToggleButton
                            x:Name="ModelPickerButton"
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            Classes="model-picker"
                            IsChecked="{Binding IsModelPickerOpen, Mode=TwoWay}"
                            ToolTip.Tip="Выбрать нейросеть">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding SelectedChatProvider.DisplayName}" Classes="model-picker-provider" />
                                <TextBlock Text="{Binding SelectedChatModel.Name}" Classes="model-picker-model" />
                            </StackPanel>
                        </ToggleButton>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon-button"
                            Command="{Binding SendCommand}"
                            ToolTip.Tip="Отправить">
                            <ic:FluentIcon
                                Icon="Send"
                                IconSize="Size20"
                                IconVariant="Regular" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!--  Настройки нейросетей  -->
            <Panel Grid.Row="1" IsVisible="{Binding IsSettingsSelected}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Panel>

            <!--  Проекты  -->
            <Panel Grid.Row="1" IsVisible="{Binding IsProjectsSelected}">
                <views:ProjectsView DataContext="{Binding Projects}" />
            </Panel>

            <!--  База знаний  -->
            <Panel Grid.Row="1" IsVisible="{Binding IsDocumentationSelected}">
                <views:SkillsView DataContext="{Binding Skills}" />
            </Panel>

            <!--  Заглушка для остальных разделов  -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsPlaceholderSelected}"
                Spacing="12">
                <ic:FluentIcon
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource MutedTextBrush}"
                    Icon="{Binding SelectedSection.Section, Converter={converters:AppSectionToIconConverter}}"
                    IconSize="Size48"
                    IconVariant="Regular" />
                <TextBlock
                    Foreground="{StaticResource MutedTextBrush}"
                    TextAlignment="Center">
                    <Run Text="{Binding SelectedSection.Title}" />
                    <Run Text=" — раздел в разработке" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!--  Меню выбора ИИ: провайдеры + модели  -->
        <Popup
            Grid.Column="1"
            IsLightDismissEnabled="True"
            IsOpen="{Binding IsModelPickerOpen, Mode=TwoWay}"
            MaxHeight="320"
            Placement="Top"
            PlacementTarget="{Binding #ModelPickerButton}">
            <Border Classes="model-picker-menu">
                <Grid ColumnDefinitions="Auto,*" MaxHeight="300">
                    <ListBox
                        MinWidth="150"
                        Classes="model-picker-providers"
                        ItemsSource="{Binding ChatProviders}"
                        SelectedItem="{Binding SelectedChatProvider}"
                        ToolTip.Tip="Провайдер нейросети">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderPickerViewModel">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Column="1" MinWidth="180">
                        <ItemsControl ItemsSource="{Binding SelectedChatProvider.Models}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiModel">
                                    <Button
                                        Classes="model-picker-item"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectChatModelCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

        <!--  Подтверждение несохранённых изменений  -->
        <Border
            Grid.ColumnSpan="2"
            Background="#99000000"
            IsVisible="{Binding IsConfirmSaveOpen}"
            ZIndex="100">
            <Border
                Width="440"
                Classes="settings-card"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Classes="page-title" Text="Несохранённые изменения" />
                    <TextBlock
                        Classes="page-subtitle"
                        Text="Настройки были изменены. Сохранить их перед переходом в другой раздел?"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="page-subtitle"
                        Foreground="{StaticResource ErrorBrush}"
                        IsVisible="{Binding ConfirmSaveError, Converter={converters:StringNotEmptyToBoolConverter}}"
                        Text="{Binding ConfirmSaveError}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Classes="settings-save" Click="OnConfirmSaveClick" ToolTip.Tip="Сохранить изменения и продолжить">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <ic:FluentIcon
                                    Icon="Save"
                                    IconSize="Size16"
                                    IconVariant="Regular" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Сохранить" />
                            </StackPanel>
                        </Button>
                        <Button Classes="dialog-action" Click="OnConfirmDiscardClick" ToolTip.Tip="Не сохранять изменения и продолжить">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <ic:FluentIcon
                                    Icon="Delete"
                                    IconSize="Size16"
                                    IconVariant="Regular" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Не сохранять" />
                            </StackPanel>
                        </Button>
                        <Button Classes="dialog-action" Click="OnConfirmCancelClick" ToolTip.Tip="Отменить переход и остаться в настройках">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <ic:FluentIcon
                                    Icon="Dismiss"
                                    IconSize="Size16"
                                    IconVariant="Regular" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Отмена" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

</Window>
