<Window
    x:Class="Ai1CAgent.Avalonia.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:models="using:Ai1CAgent.Core.Models"
    xmlns:vm="using:Ai1CAgent.Avalonia.ViewModels"
    Icon="/Assets/avalonia-logo.ico"
    Title="Ai1CAgent">

    <Grid
        Margin="12"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="8">

        <ComboBox
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding Models}"
            SelectedItem="{Binding SelectedModel}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:AiModel">
                    <TextBlock>
                        <Run Text="{Binding Provider}" />
                        <Run Text=": " />
                        <Run Text="{Binding Name}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <TextBox
                Grid.Column="0"
                AcceptsReturn="True"
                PlaceholderText="Запрос к нейросети"
                Text="{Binding Prompt}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Stretch"
                Command="{Binding SendCommand}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <ic:FluentIcon
                        Icon="Send"
                        IconSize="Size20"
                        IconVariant="Regular" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Отправить" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBox
            Grid.Row="2"
            IsReadOnly="True"
            Text="{Binding Answer}"
            TextWrapping="Wrap" />
    </Grid>

</Window>
