<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <!-- Serilog.Settings.Configuration несовместим с trimming (типы/sinks по строкам из appsettings.json),
             поэтому сборки Serilog исключены из тримминга через TrimmerRootAssembly ниже. -->
        <NoWarn>$(NoWarn);IL2104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="FluentIcons.Avalonia" Version="2.1.344" />
        <PackageReference Include="Markdown.Avalonia.SyntaxHigh" Version="12.0.0-a3" />
        <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    </ItemGroup>

    <!-- Dev-only in-process MCP-инспектор (loopback 127.0.0.1:5599). Тянет ASP.NET/MCP-стек,
         поэтому подключается только в Debug и никогда не попадает в Release/тримминг. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Declarative.Avalonia.AgentTools" Version="12.1.1" />
    </ItemGroup>

    <!-- Транзитивный Avalonia.Markup.Declarative несёт source generator под Roslyn 5.3, а SDK
         10.0.112 несёт Roslyn 5.0 (CS9057). Приложение использует XAML, а не декларативные
         ViewBase, поэтому генератор не нужен — удаляем его из набора анализаторов. -->
    <Target Name="RemoveDeclarativeSourceGenerator" AfterTargets="ResolveLockFileAnalyzers" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Debug'">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Avalonia.Markup.Declarative.SourceGenerator'" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <TrimmerRootAssembly Include="Serilog" />
        <TrimmerRootAssembly Include="Serilog.Extensions.Logging" />
        <TrimmerRootAssembly Include="Serilog.Settings.Configuration" />
        <TrimmerRootAssembly Include="Serilog.Sinks.Console" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ai1CAgent.Core\Ai1CAgent.Core.csproj" />
        <ProjectReference Include="..\Ai1CAgent.Modules\Ai1CAgent.Modules.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
</Project>
