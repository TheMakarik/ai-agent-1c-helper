{
  "AiOptions": {
    "Title": "1С:АгентПомощник",
    "MaxOutputTokens": 16000,
    "Providers": []
  },

  "OllamaOptions": {
    "Endpoint": "http://localhost:11434",
    "Models": [
      "qwen3.5:9b",
      "gemma4:e4b"
    ],
    "RequestTimeout": "00:10:00"
  },

  "McpOptions": {
    "Servers": [
      {
        "Name": "1c-metacode",
        "Transport": "Http",
        "Endpoint": "http://localhost:6001/mcp"
      }
    ]
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm}] [{Level}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
