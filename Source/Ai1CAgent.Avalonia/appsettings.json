{
  "AiOptions": {
    "Title": "1С:АгентПомощник",
    "MaxOutputTokens": 16000,
    "Providers": [
      {
        "Provider": "DeepSeek",
        "Models": [
          { "Name": "deepseek-flash", "Format": "OpenAi" },
          { "Name": "deepseek-v4-pro", "Format": "OpenAi" }
        ]
      },
      {
        "Provider": "Claude",
        "Models": [
          { "Name": "claude-fable-5-1", "Format": "Anthropic" },
          { "Name": "claude-opus-5-5", "Format": "Anthropic" },
          { "Name": "claude-sonnet-5-5", "Format": "Anthropic" },
          { "Name": "claude-haiku-5-5", "Format": "Anthropic" }
        ]
      },
      {
        "Provider": "Kimi",
        "Models": [
          { "Name": "kimi-k3", "Format": "OpenAi" },
          { "Name": "kimi-k2.7-code", "Format": "OpenAi" },
          { "Name": "kimi-k2.6", "Format": "OpenAi" }
        ]
      },
      {
        "Provider": "Glm",
        "Models": [
          { "Name": "glm-5.3", "Format": "OpenAi" },
          { "Name": "glm-5.3-flash", "Format": "OpenAi" },
          { "Name": "glm-5.3-flashx", "Format": "OpenAi" },
          { "Name": "glm-5.2", "Format": "OpenAi" }
        ]
      },
      {
        "Provider": "ChatGpt",
        "Models": [
          { "Name": "gpt-6-astra", "Format": "OpenAi" },
          { "Name": "gpt-6.1-sol", "Format": "OpenAi" },
          { "Name": "gpt-6-luna", "Format": "OpenAi" },
          { "Name": "gpt-5.6-terra", "Format": "OpenAi" }
        ]
      },
      {
        "Provider": "Qwen",
        "Models": [
          { "Name": "qwen3.8-max", "Format": "OpenAi" },
          { "Name": "qwen3.8-flash", "Format": "OpenAi" },
          { "Name": "qwen3.7-plus", "Format": "OpenAi" },
          { "Name": "qwen3.7-flash", "Format": "OpenAi" }
        ]
      }
    ]
  },

  "OllamaOptions": {
    "Endpoint": "http://localhost:11434",
    "Models": [
      "qwen3.5:9b",
      "gemma4:e4b"
    ],
    "RequestTimeout": "00:10:00"
  },

  "McpOptions": {
    "Servers": [
      {
        "Name": "1c-metacode",
        "Transport": "Http",
        "Endpoint": "http://localhost:6001/mcp"
      }
    ]
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm}] [{Level}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
